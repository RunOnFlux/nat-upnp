{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test"
  },
  "mutate": [
    "src/**/*.ts"
  ],
  "coverageAnalysis": "off",
  "disableTypeChecks": true,
  "concurrency": 14,
  "timeoutMS": 120000
}
