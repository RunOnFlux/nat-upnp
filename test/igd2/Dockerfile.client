FROM node:24-trixie-slim

# iptables is what the "caching survives an SSDP block" testcase reaches for;
# iproute2 and iputils are here so the container can be poked at by hand.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      iptables \
      iproute2 \
      iputils-ping \
      curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
